# Copie este arquivo para ".env" e preencha os valores.
# No Railway, o plugin MySQL injeta MYSQLHOST/MYSQLPORT/MYSQLUSER/MYSQLPASSWORD/MYSQLDATABASE
# automaticamente — essas variáveis DB_* abaixo são só para rodar localmente (docker-compose).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=senha_local_dev
DB_NAME=academia

JWT_SECRET=troque-este-segredo-em-producao

PORT=3000

# E-mail transacional (link de "esqueci minha senha") — via Resend.
# Sem isso configurado, o link é logado no console em vez de enviado.
RESEND_API_KEY=
FROM_EMAIL=Gestão de Academia <onboarding@resend.dev>

# Backup automático do banco (server/backup.js) — Cloudflare R2 (compatível
# com S3). Sem isso configurado, o backup agendado fica desativado.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
